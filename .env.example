# RekaSDA Pro — Environment Variables Template
# Copy this file to .env.local (frontend) and backend/.env (backend), then fill in your values.
# ⚠️  Jangan pernah commit file .env atau .env.local ke Git!

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────

# URL Python FastAPI Engine
# Development: http://localhost:8000
# Production : https://api.rekasda.go.id
VITE_API_URL=http://localhost:8000

# Supabase (opsional — biarkan kosong untuk dev lokal tanpa DB)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Gemini API Key (untuk fitur AI/OCR)
VITE_GEMINI_API_KEY=

# ─── Backend (FastAPI / Python) ───────────────────────────────────────────────

# Daftar origin frontend yang diizinkan mengakses API (pisahkan dengan koma)
# Development : http://localhost:5173,http://localhost:3000,http://localhost:4173
# Production  : https://rekasda.go.id,https://www.rekasda.go.id
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# Sentry DSN untuk error tracking backend (opsional)
SENTRY_DSN=
